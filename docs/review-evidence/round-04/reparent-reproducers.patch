+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { fireEvent, render } from '@testing-library/react'
+import LanguageProvider from '../../i18n/LanguageProvider.jsx'
+import FreeCanvasItem from './FreeCanvasItem.jsx'
+import { useEditorStore, selectCurrentPage } from '../../store/editorStore.js'
+const s = () => useEditorStore.getState()
+const page = () => selectCurrentPage(s())
+const node=(id,type,layout,props={},children)=>({id,type,layout,props,styles:{},...(children?{children}:{} )})
+const get=(id,list=page().components)=>list.flatMap(n=>[n,...(n.children?flatten(n.children):[])]).find(n=>n.id===id)
+const flatten=list=>list.flatMap(n=>[n,...(n.children?flatten(n.children):[])])
+function Canvas(){const p=useEditorStore(selectCurrentPage);return <LanguageProvider><div id="canvas-scroll"><div id="free-canvas" data-builder-canvas-scale="1">{p.components.map(c=><FreeCanvasItem key={c.id} component={c} canvasScale={1}/>)}</div></div></LanguageProvider>}
+const rect=(left,top,width,height)=>({left,top,width,height,right:left+width,bottom:top+height,x:left,y:top})
+function load(type='text',props={},nested=false){
+ s().loadSchema({pages:[{id:'p',name:'Home',mode:'empty',canvasWidth:1000,mobileWidth:390,mobileManual:true,components:[
+ node('target','container',{x:400,y:100,w:400,h:300},{},[]),
+ ...(nested?[node('source','container',{x:40,y:500,w:400,h:300},{},[node('dragged',type,{x:40,y:40,w:180,h:60},props)])]:[node('dragged',type,{x:40,y:500,w:180,h:60},props)]),
+ node('other','text',{x:40,y:900,w:180,h:60},{text:'Other'})]}]});s().setViewport('pc')
+}
+function perform(nested=false){
+ const v=render(<Canvas/>);const canvas=v.container.querySelector('#free-canvas');canvas.getBoundingClientRect=()=>rect(0,0,1000,2000)
+ const marker=v.container.querySelector('[data-builder-droppable-id="target"]');marker.getBoundingClientRect=()=>rect(400,100,400,300)
+ const item=v.container.querySelector('[data-cid="dragged"]');item.getBoundingClientRect=()=>rect(40,nested?540:500,180,60)
+ document.elementsFromPoint=vi.fn(()=>[marker,canvas]);
+ fireEvent.pointerDown(item,{button:0,clientX:80,clientY:nested?570:530})
+ fireEvent(window,new MouseEvent('pointermove',{bubbles:true,clientX:480,clientY:180}))
+ fireEvent(window,new MouseEvent('pointerup',{bubbles:true,clientX:480,clientY:180}))
+ return {v}
+}
+beforeEach(()=>{globalThis.ResizeObserver=class{observe(){}disconnect(){}}})
+afterEach(()=>{delete document.elementsFromPoint;vi.restoreAllMocks()})
+describe('review guard probes',()=>{
+ it('fixed pinned stays on page',()=>{load('text',{scrollBehavior:'fixed'});perform();expect(page().components.map(n=>n.id)).toContain('dragged')})
+ it('sticky pinned stays on page',()=>{load('text',{scrollBehavior:'sticky'});perform();expect(page().components.map(n=>n.id)).toContain('dragged')})
+ it('full width navbar stays on page',()=>{load('navbar',{brand:'Nav'});perform();expect(page().components.map(n=>n.id)).toContain('dragged')})
+ it('boxed navbar stays on page',()=>{load('navbar',{brand:'Nav',widthMode:'boxed'});perform();expect(page().components.map(n=>n.id)).toContain('dragged')})
+ it('vertical navbar stays on page',()=>{load('navbar',{brand:'Nav',navLayout:'vertical'});perform();expect(page().components.map(n=>n.id)).toContain('dragged')})
+ it('top-level multiselection stays on page',()=>{load();s().selectComponent('dragged');s().toggleSelect('other');perform();expect(page().components.map(n=>n.id)).toContain('dragged');expect(get('target').children).toHaveLength(0)})
+ it('nested multiselection stays in parent',()=>{load('text',{},true);s().selectComponent('dragged');s().toggleSelect('other');perform(true);expect(get('source').children.map(n=>n.id)).toContain('dragged');expect(get('target').children).toHaveLength(0)})
+})
